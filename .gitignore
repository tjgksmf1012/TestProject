# ── Python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ── Node / Next.js ────────────────────────────────────────
node_modules/
.next/
# ⚠️ esbuild 산출물(`frontend/public/*.js`)은 **커밋합니다.**
#
# 무시하고 있었는데, 그 상태에서 README 가 안내하는 대로 clone → seed →
# uvicorn 을 하면 `/main.js` 와 `/review.js` 가 404 라 녹음 화면과 승인
# 화면이 **빈 화면으로 뜹니다.** 오류도 안 납니다.
#
# 이 프로젝트는 프런트 런타임 의존성이 셋뿐이고(react·react-dom·radix)
# 시연 경로의 전제입니다. Node 없이도 화면이 떠야 하므로 번들을 넣습니다.
# 소스를 고치면 `npm run build:demo` 로 다시 만들어 같이 커밋하세요 —
# `test_repo_integrity.py` 가 HTML 이 부르는 파일이 저장소에 있는지 봅니다.
out/
dist/
build/
*.tsbuildinfo

# ── 환경 변수 / 시크릿 ─────────────────────────────────────
# HF_TOKEN, GITHUB_APP_PRIVATE_KEY, GITHUB_WEBHOOK_SECRET,
# AUDIO_ENCRYPTION_KEY 등이 여기 들어갑니다. 절대 커밋 금지.
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ── AI 모델 가중치 ────────────────────────────────────────
# 합계 30~50GB. git에 넣지 마세요. HuggingFace에서 받으세요.
models/
checkpoints/
*.safetensors
*.gguf
*.bin
*.ckpt
*.pt
*.pth
.cache/huggingface/

# ── 회의 오디오 / 개인정보 ────────────────────────────────
# 음성은 개인정보이며 생체인식정보로 간주될 수 있습니다.
# 저장소에 절대 올리지 마세요. → docs/07-법적-윤리-요구사항.md
#
# ⚠️ 경로를 반드시 `/` 로 시작하세요.
# 예전에 `audio/` 라고만 적어뒀더니 **소스 패키지 `backend/teamflow/audio/`
# 가 통째로 무시됐습니다.** `git add -A` 는 무시된 파일을 조용히 건너뛰기
# 때문에 커밋은 성공하고, 새로 clone 하면 모듈이 없어 테스트가 깨집니다.
# 저장 디렉터리만 가리키도록 앵커링합니다.
/audio/
/recordings/
/uploads/
/var/
data/audio/
*.wav
*.mp3
*.m4a
*.opus
*.flac
*.webm

