{
  "name": "teamflow-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TeamFlow AI 녹음 클라이언트 — 순수 로직은 의존성 0으로 검증된다",
  "scripts": {
    "test": "node --test 'src/lib/**/*.test.ts'",
    "test:watch": "node --test --watch 'src/lib/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "build:demo": "esbuild src/demo/main.ts src/demo/review.ts --bundle --format=esm --target=es2022 --outdir=public",
    "check": "npm run typecheck && npm test",
    "serve": "python3 -m http.server 3000 --directory public"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3"
  }
}
