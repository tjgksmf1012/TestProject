# TeamFlow AI 환경 변수 예시
#
#   cp .env.example .env
#
# ⚠️ .env 는 커밋되지 않습니다 (.gitignore). 실제 시크릿을 여기에 쓰지 마세요.

ENVIRONMENT=development
DEBUG=false

# ── 인프라 ──────────────────────────────────────────────────
POSTGRES_USER=teamflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=teamflow
DATABASE_URL=postgresql+psycopg://teamflow:change-me@localhost:5432/teamflow
REDIS_URL=redis://localhost:6379/0

# ── 오디오 저장 ─────────────────────────────────────────────
# 개인정보보호법상 음성(생체인식정보)은 다른 개인정보와 분리 보관해야 합니다.
# 별도 볼륨 + 별도 암호화 키 + 별도 접근 권한. → docs/07 P4
AUDIO_STORAGE_ROOT=/var/teamflow/audio
AUDIO_ENCRYPTION_KEY_ID=change-me

# 보존기간. 만료 시 원본 오디오만 지우고 전사 텍스트는 남깁니다. → docs/07 §2.4
RAW_AUDIO_RETENTION_DAYS=30
SEGMENT_AUDIO_RETENTION_DAYS=30
TRANSCRIPT_RETENTION_DAYS=365

# ── GitHub App ──────────────────────────────────────────────
# OAuth App이 아니라 GitHub App을 씁니다. → docs/03 §4.1
# 권한: Contents:Read, Pull requests:Read, Issues:Read, Metadata:Read
# 쓰기 권한은 요청하지 마세요.
#
# 이 둘이 있어야 병합된 PR 의 diff 와 리뷰를 조회해 기여 이벤트를 만듭니다.
# 없으면 웹훅은 GithubEvent 만 저장하고 기여도에는 반영되지 않습니다.
#
# 설치 id 는 여기가 아니라 **프로젝트마다** 저장됩니다
# (projects.github_installation_id) — 앱 하나가 여러 팀 저장소에 설치되고
# 토큰은 설치 단위로 발급되기 때문입니다.
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=

# ⚠️ 필수. 이게 없으면 누구나 가짜 이벤트를 주입해 기여도를 조작할 수 있습니다.
#    openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# ── AI ──────────────────────────────────────────────────────
# pyannote community-1 은 HuggingFace gated 모델입니다.
# huggingface.co 에서 사용 동의 후 토큰을 발급받으세요.
HF_TOKEN=

# llm_backend: llamacpp | vllm | fake
# RAM 32GB 환경에서는 llamacpp(CPU)가 1순위입니다. → docs/02 §5 전략 C
LLM_BACKEND=llamacpp
LLM_BASE_URL=http://localhost:8080/v1
LLM_MODEL=local
LLM_GGUF=qwen3-8b-q4_k_m.gguf
LLM_CONTEXT=16384
LLM_THREADS=8

# Apache 2.0 모델을 기본으로 씁니다.
# EXAONE 4.0 은 NC(비상업) 라이선스라 상업화 시 사용할 수 없습니다. → docs/10 Q2
ASR_MODEL=Qwen/Qwen3-ASR-1.7B
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1

# GPU 배타 락 TTL(초). 워커가 죽으면 이 시간 뒤 자동 해제됩니다.
GPU_LOCK_TTL=1800

# ── 로그 ────────────────────────────────────────────────────
# 이 시스템의 결함은 대부분 예외 없이 조용히 일어납니다(트랙 하나가 버려지고,
# 회의가 큐에서 멈추고). 그때 남는 유일한 흔적이 INFO 로그입니다.
#
# LOG_FORMAT=json 은 로그 수집기를 붙였을 때 씁니다. 사람이 터미널에서
# 읽을 때는 text 가 낫습니다.
LOG_LEVEL=INFO
LOG_FORMAT=text

# ── 포트 ────────────────────────────────────────────────────
API_PORT=8000
LLM_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379
