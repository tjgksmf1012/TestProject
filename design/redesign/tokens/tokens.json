{
  "$description": "TeamFlow 'Instrument' design tokens. W3C Design Tokens Format Module (2025.10). 원칙: 색은 '근거가 있다'(evidence) 또는 '모른다'(unknown)일 때만 나타난다.",
  "color": {
    "$type": "color",
    "neutral": {
      "paper":        { "$value": "#FAFAFB", "$description": "페이지 배경 (라이트)" },
      "surface":      { "$value": "#FFFFFF", "$description": "카드 / 올라온 면" },
      "surfaceRaised":{ "$value": "#FFFFFF", "$description": "팝오버·드롭다운" },
      "sunken":       { "$value": "#F0F1F4", "$description": "전사·코드·입력 우물" },
      "line":         { "$value": "#E3E5EA", "$description": "헤어라인 (비인터랙티브)" },
      "lineStrong":   { "$value": "#C9CDD6", "$description": "인터랙티브 테두리" },
      "ink":          { "$value": "#15171E", "$description": "본문·제목" },
      "inkMuted":     { "$value": "#5B6172", "$description": "보조 설명" },
      "inkFaint":     { "$value": "#878EA0", "$description": "비필수. 여기에만 있는 정보 금지" },
      "inkInverse":   { "$value": "#FFFFFF" }
    },
    "semantic": {
      "evidence":       { "$value": "#3D3AAE", "$description": "근거가 있다 / 실행 가능하다. 유일한 주 액센트" },
      "evidenceHover":  { "$value": "#322F94" },
      "evidenceActive": { "$value": "#29277C" },
      "evidenceTint":   { "$value": "#ECECF9" },
      "evidenceLine":   { "$value": "#C9C7EE" },
      "unknown":        { "$value": "#A8701A", "$description": "측정하지 못했다. 빨강 대용 아님 — 비난의 의미 없음" },
      "unknownTint":    { "$value": "#FAF1E0" },
      "unknownLine":    { "$value": "#E8D3AC" },
      "danger":         { "$value": "#B02E2E", "$description": "되돌릴 수 없는 파괴적 작업에만" },
      "dangerTint":     { "$value": "#FCEEEE" },
      "dangerLine":     { "$value": "#F0C7C7" },
      "ok":             { "$value": "#1F6B45", "$description": "시스템 연결 상태에만. 점수·성과에 쓰지 말 것" },
      "okTint":         { "$value": "#E9F5EE" }
    },
    "dark": {
      "$description": "다크는 라이트의 반전이 아니라 별도 설계값이다",
      "paper":        { "$value": "#121319" },
      "surface":      { "$value": "#191B23" },
      "surfaceRaised":{ "$value": "#21242E" },
      "sunken":       { "$value": "#0E0F14" },
      "line":         { "$value": "#2A2E3B" },
      "lineStrong":   { "$value": "#3D4354" },
      "ink":          { "$value": "#E9EBF2", "$description": "순백 아님 — 헤일레이션 방지" },
      "inkMuted":     { "$value": "#9BA2B5" },
      "inkFaint":     { "$value": "#6E7688" },
      "evidence":     { "$value": "#8F8BF2", "$description": "라이트 대비 밝히고 채도 낮춤" },
      "evidenceTint": { "$value": "#23234A" },
      "unknown":      { "$value": "#D6A24F" },
      "unknownTint":  { "$value": "#332A16" },
      "danger":       { "$value": "#E06A6A" },
      "ok":           { "$value": "#5FBF8C" }
    }
  },
  "fontFamily": {
    "$type": "fontFamily",
    "sans":    { "$value": ["Pretendard Variable", "Pretendard", "-apple-system", "system-ui", "sans-serif"], "$description": "사람이 말한 것" },
    "display": { "$value": ["Wanted Sans Variable", "Wanted Sans", "Pretendard Variable", "sans-serif"], "$description": "화면 제목·로고타입 전용. 본문 금지" },
    "mono":    { "$value": ["JetBrains Mono", "IBM Plex Mono", "ui-monospace", "monospace"], "$description": "기계가 잰 것 — 모든 측정값" }
  },
  "fontSize": {
    "$type": "dimension",
    "11": { "$value": { "value": 11, "unit": "px" }, "$description": "마이크로 라벨 (대문자, 자간 +0.06em)" },
    "12": { "$value": { "value": 12, "unit": "px" }, "$description": "메타·캡션" },
    "13": { "$value": { "value": 13, "unit": "px" }, "$description": "조밀 UI 기본값" },
    "14": { "$value": { "value": 14, "unit": "px" }, "$description": "본문" },
    "16": { "$value": { "value": 16, "unit": "px" } },
    "20": { "$value": { "value": 20, "unit": "px" }, "$description": "섹션 제목" },
    "26": { "$value": { "value": 26, "unit": "px" }, "$description": "화면 제목" },
    "34": { "$value": { "value": 34, "unit": "px" }, "$description": "기여도 구간 등 큰 수치" },
    "46": { "$value": { "value": 46, "unit": "px" }, "$description": "로그인 히어로 전용" }
  },
  "spacing": {
    "$type": "dimension",
    "$description": "4px 그리드",
    "1":  { "$value": { "value": 2,  "unit": "px" } },
    "2":  { "$value": { "value": 4,  "unit": "px" } },
    "3":  { "$value": { "value": 6,  "unit": "px" } },
    "4":  { "$value": { "value": 8,  "unit": "px" } },
    "5":  { "$value": { "value": 12, "unit": "px" } },
    "6":  { "$value": { "value": 16, "unit": "px" }, "$description": "카드 안쪽 여백 기본" },
    "7":  { "$value": { "value": 20, "unit": "px" } },
    "8":  { "$value": { "value": 24, "unit": "px" } },
    "9":  { "$value": { "value": 32, "unit": "px" } },
    "10": { "$value": { "value": 40, "unit": "px" } },
    "11": { "$value": { "value": 56, "unit": "px" } },
    "12": { "$value": { "value": 72, "unit": "px" } }
  },
  "borderRadius": {
    "$type": "dimension",
    "sm":   { "$value": { "value": 4,   "unit": "px" }, "$description": "컨트롤" },
    "md":   { "$value": { "value": 6,   "unit": "px" }, "$description": "카드" },
    "lg":   { "$value": { "value": 10,  "unit": "px" }, "$description": "모달·팝오버" },
    "full": { "$value": { "value": 999, "unit": "px" }, "$description": "알약" }
  },
  "layout": {
    "$type": "dimension",
    "railWidth":  { "$value": { "value": 72,  "unit": "px" }, "$description": "좌측 아이콘 레일" },
    "headerHeight":{ "$value": { "value": 56, "unit": "px" } },
    "paneGap":    { "$value": { "value": 1,   "unit": "px" }, "$description": "판 사이는 헤어라인 하나" }
  },
  "ribbon": {
    "$description": "시그니처 컴포넌트 — 트랙 리본. 한 컴포넌트, 세 배율",
    "heightLg": { "$type": "dimension", "$value": { "value": 30, "unit": "px" }, "$description": "회의 로비 — 참가자별 40분 축" },
    "heightMd": { "$type": "dimension", "$value": { "value": 14, "unit": "px" }, "$description": "홈 — 회의별 커버리지" },
    "heightSm": { "$type": "dimension", "$value": { "value": 6,  "unit": "px" }, "$description": "기여도 — 확신 폭" },
    "radius":   { "$type": "dimension", "$value": { "value": 2,  "unit": "px" } }
  },
  "duration": {
    "$type": "duration",
    "fast": { "$value": { "value": 120, "unit": "ms" } },
    "base": { "$value": { "value": 180, "unit": "ms" } },
    "slow": { "$value": { "value": 320, "unit": "ms" }, "$description": "리본 최초 스윕 1회에만" }
  },
  "cubicBezier": {
    "$type": "cubicBezier",
    "standard": { "$value": [0.2, 0, 0, 1] }
  }
}
